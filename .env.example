APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
# URL du SPA (portail client). Si vide, utilise « URL du site » (site_url) dans Paramètres généraux, sinon APP_URL.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=10

# Local uniquement : évite les fatal "Maximum execution time 30s" si l’autoload / l’antivirus Windows ralentit PHP.
APP_MAX_EXECUTION_TIME=120

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

# Doit inclure l’hôte exact du navigateur (avec port). Si vous ouvrez le SPA via l’IP LAN
# (ex. http://192.168.1.67:5173), ajoutez 192.168.1.67:5173 ici et dans CORS_ALLOWED_ORIGINS.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,localhost:3000,127.0.0.1:5173,127.0.0.1:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log = aucun envoi réel (écriture dans storage/logs) — le client ne reçoit rien dans sa boîte.
# smtp = envoi réel ; ou laissez log et configurez l’hôte SMTP dans Paramètres (table settings).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Référentiel géographique : dossier racine contenant countries.json, states.json (défaut : backend/countries-states-cities-database)
LOCATION_JSON_PATH=
# Optionnel : dossier du cities.csv (défaut : {LOCATION_JSON_PATH}/csv)
LOCATION_CSV_PATH=

# Premier compte super_admin (à personnaliser, surtout le mot de passe en production)
SEED_SUPER_ADMIN_EMAIL=admin@monrespro.local
SEED_SUPER_ADMIN_PASSWORD=password

